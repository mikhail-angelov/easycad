# Production environment for easycad.bconf.com.
# Copy to `.env.prod`, fill in the secrets, then `make install` ships it to the
# server as /opt/easycad/.env. Do NOT commit the filled-in .env.prod.

# ── Auth (SPEC13) ────────────────────────────────────────────────────────────
JWT_SECRET=                       # long random string — signs magic-link + session JWTs
APP_URL=https://easycad.bconf.com # base URL used in magic-link emails
# BYOK keys are encrypted at rest (SPEC14). By default the encryption key is
# derived from JWT_SECRET; set a dedicated one to decouple them (rotating it
# makes stored BYOK keys unreadable → users re-enter, sessions unaffected).
# EASYCAD_SECRETS_KEY=

# ── Email (magic link) — same Yandex postbox as playground ───────────────────
MAIL_FROM=no-reply@js2go.ru
POST_SERVICE_URL=postbox.cloud.yandex.net
POST_USER=
POST_PASS=

# ── Free trial + BYOK (SPEC14) ───────────────────────────────────────────────
# New visitors get free generations on the operator's DeepSeek key before they
# add their own, so DEEP_SEEK_KEY is REQUIRED for the trial to work (not just a
# dev fallback). After the grant, users bring their own key (BYOK).
DEEP_SEEK_KEY=                     # operator key that powers the free trial
EASYCAD_TRIAL_ANON=1              # free generations for an anonymous visitor (by IP)
EASYCAD_TRIAL_USER=10             # free generations for a signed-in account
# EASYCAD_ANON_TRIAL_TTL=2592000  # prune anon IP rows older than N seconds (default 30d)
# Set both TRIAL_* to 0 to disable the trial (then users must add their own key).

# ── Cost controls (recommended before a public launch/traffic spike) ─────────
# Daily kill-switch: cap operator-key trial generations per UTC day (0 = off).
# Over budget, trial users are asked to add their own key. Tune to your spend.
EASYCAD_TRIAL_DAILY_BUDGET=1000
# Per-IP generation rate, req/min (closes the cookie-rotation bypass).
EASYCAD_GEN_RATE_LIMIT_IP=60
# Max concurrent LLM/worker generation requests on this instance (0 = unlimited).
EASYCAD_MAX_INFLIGHT_GEN=8

# ── Operator / admin ─────────────────────────────────────────────────────────
# The single operator identity — set to YOUR email. Sign in as this address to
# reach the admin surface (GET /api/admin/stats — counters, latency, budget,
# sessions, feedback); it's hidden (404) for everyone else, and feedback/budget
# alerts are emailed here. Unset → admin disabled and no ops mail is sent.
# NOTE: never commit a real address here — the real value belongs only in .env.
ADMIN_EMAIL=ops@example.com
# OPEN_ROUTER_KEY=                 # optional — only a local/dev BYOK env fallback

# ── Sessions & storage ───────────────────────────────────────────────────────
EASYCAD_DB_PATH=/data/easycad.db  # accounts + settings (durable)
EASYCAD_SESSION_TTL=7200          # idle session eviction, seconds
EASYCAD_MAX_SESSIONS=500
EASYCAD_SECURE_COOKIES=1          # cookies only over HTTPS (redoproxy terminates TLS)

# ── Execution worker (SPEC12) ────────────────────────────────────────────────
EASYCAD_WORKER_URL=http://worker:8853
CADQUERY_WORKER_TIMEOUT_SECONDS=120
# SPEC18 zygote-fork execution: import CadQuery once, fork a one-shot child per
# request (~import cost amortised). 1 = on, 0 = fresh subprocess per request
# (default). The worker container reads only this var (see docker-compose-prod).
EASYCAD_WORKER_ZYGOTE=1

# ── Web analytics (Yandex.Metrica) ───────────────────────────────────────────
# Numeric counter id from metrika.yandex.ru. Set → the Metrica tag (Webvisor +
# click/link maps + funnel goals) is injected into the landing and the SPA
# shell; unset (default) → both surfaces stay tracker-free. The id is public
# (it ships in every visitor's HTML), so it's fine in a non-secret config.
# YANDEX_METRICA_ID=12345678
